<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.legacy.TypedMapper">

  <select id="asBean" resultType="com.example.legacy.LegacyUser">
    SELECT id, reg_date FROM users WHERE id = #{id}
  </select>

  <select id="asMap" resultType="map">
    SELECT id, name FROM users
  </select>

  <select id="asHashMap" resultType="java.util.HashMap">
    SELECT id, name FROM users
  </select>

  <select id="deepPath" resultType="com.example.legacy.LegacyUser">
    SELECT id FROM users WHERE city = #{order.customer.city}
  </select>

  <select id="oneHopIsFine" resultType="com.example.legacy.LegacyUser">
    SELECT id FROM users WHERE name = #{user.name}
  </select>

  <update id="inlineHandler">
    UPDATE users SET flags = #{flags,typeHandler=com.example.legacy.FlagsHandler} WHERE id = #{id}
  </update>

</mapper>
