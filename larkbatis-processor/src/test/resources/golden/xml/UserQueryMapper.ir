mapper com.example.app.UserQueryMapper
  SELECT search -> MANY result:com.example.app.User reader:POSITIONAL_CANONICAL
    local c0 = q.getName() != null
    local c1 = q.getMinAge() != null
    seg   always
      text  |SELECT id, name, email, created_at FROM users|
    seg   if c0 | c1
      text  | WHERE|
    seg   if c0
      text  | name LIKE |
      bind  name = q.getName() : STRING
    seg   if c1
      alt   c0 ? | AND age >= | : | age >= |
      bind  minAge = q.getMinAge() : BOX_INT
    seg   always
      text  | ORDER BY id|
  SELECT byStatus -> MANY result:com.example.app.User reader:POSITIONAL_CANONICAL
    local c0 = q.getStatus() != null
    local c1 = !c0
    seg   always
      text  |SELECT id, name, email, created_at FROM users WHERE 1 = 1|
    seg   if c0
