<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.larkbatis.conformance.fixtures.ConformanceQueryMapper">

  <sql id="cols">id, name, age, email, created_at</sql>

  <select id="search" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users
    <where>
      <if test="name != null">AND name LIKE #{name}</if>
      <if test="minAge != null">AND age &gt;= #{minAge}</if>
    </where>
    ORDER BY id
  </select>

  <select id="byStatus" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE 1 = 1
    <choose>
      <when test="status != null">AND status = #{status}</when>
      <otherwise>AND status = 'NEW'</otherwise>
    </choose>
    ORDER BY id
  </select>

  <update id="updateUser">
    UPDATE users
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="email != null">email = #{email},</if>
    </set>
    WHERE id = #{id}
  </update>

  <select id="listAll" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users ORDER BY id
  </select>

  <!-- <foreach>. "list" is what ParamNameResolver calls a
       sole collection parameter, so both frameworks resolve it the same. -->
  <select id="findByIds" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE id IN
    <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY id
  </select>

  <select id="searchInIds" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE id IN
    <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY id
  </select>

  <select id="searchOptionalIds" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users
    <where>
      <if test="name != null">AND name LIKE #{name}</if>
      <if test="ids != null">
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
      </if>
    </where>
    ORDER BY id
  </select>

  <select id="findByIdsOrdered" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE id IN
    <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY CASE id
    <foreach collection="list" item="orderedId" index="position">
      WHEN #{orderedId} THEN #{position}
    </foreach>
    END
  </select>

  <select id="findByColumnValues" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE
    <foreach collection="filters" item="value" index="column" separator=" OR ">
      (name = #{column} AND email = #{value})
    </foreach>
    ORDER BY id
  </select>

  <insert id="insertAll">
    INSERT INTO users (name, email) VALUES
    <foreach collection="users" item="u" separator=",">
      (#{u.name}, #{u.email})
    </foreach>
  </insert>

  <select id="foreachOpensTheWhere" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users
    <where>
      <foreach collection="list" item="id" open="AND id IN (" separator="," close=")">#{id}</foreach>
    </where>
    ORDER BY id
  </select>

  <select id="unionOfIds" resultType="long">
    <foreach collection="list" item="id" separator="UNION ALL">SELECT #{id}</foreach>
  </select>

  <select id="chooseWithForeach" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE 1 = 1
    <choose>
      <when test="ids != null">
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
      </when>
      <when test="name != null">AND name LIKE #{name}</when>
      <otherwise>AND status = 'NEW'</otherwise>
    </choose>
    ORDER BY id
  </select>

  <select id="searchWhereForeachOnly" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users
    <where>
      <foreach collection="list" item="id" separator=" OR ">id = #{id}</foreach>
    </where>
    ORDER BY id
  </select>

  <select id="adjacentForeach" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE id IN
    <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    <foreach collection="names" item="nm" open="AND name IN (" separator="," close=")">#{nm}</foreach>
    ORDER BY id
  </select>

  <select id="spaceSeparator" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE id IN
    <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY CASE id
    <foreach collection="list" item="oid" index="p" separator=" ">WHEN #{oid} THEN #{p}</foreach>
    END
  </select>

  <select id="findByIdGroups" resultType="io.github.larkbatis.conformance.fixtures.User">
    SELECT <include refid="cols"/> FROM users WHERE
    <foreach collection="list" item="group" separator=" OR ">
      id IN
      <foreach collection="group" item="id" open="(" separator="," close=")">#{id}</foreach>
    </foreach>
    ORDER BY id
  </select>

  <delete id="deleteByIds">
    DELETE FROM users WHERE name &lt;&gt; #{keepName} AND id IN
    <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
  </delete>

</mapper>
